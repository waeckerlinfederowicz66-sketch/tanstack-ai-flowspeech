{
  "name": "tanstack-ai-flowspeech",
  "version": "0.1.0",
  "description": "FlowSpeech text-to-speech adapter for TanStack AI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waeckerlinfederowicz66-sketch/tanstack-ai-flowspeech.git"
  },
  "homepage": "https://flowspeech.io/",
  "bugs": {
    "url": "https://github.com/waeckerlinfederowicz66-sketch/tanstack-ai-flowspeech/issues"
  },
  "keywords": [
    "tanstack",
    "tanstack-ai",
    "flowspeech",
    "text-to-speech",
    "tts",
    "ai",
    "voice"
  ],
  "peerDependencies": {
    "@tanstack/ai": "^0.45.1"
  },
  "devDependencies": {
    "@tanstack/ai": "^0.45.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
